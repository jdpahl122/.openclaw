# WNY News Tool Configuration
# Copy to .env and adjust as needed

# Output directory (default: ./output)
WNY_NEWS_OUTPUT_DIR=output

# Default time window in hours
WNY_NEWS_DEFAULT_HOURS=24

# Default number of top stories
WNY_NEWS_DEFAULT_TOP_N=10

# HTTP settings
WNY_NEWS_HTTP_TIMEOUT=15
WNY_NEWS_USER_AGENT=OpenClaw-WNY-News/1.0

# LLM summarization (Mode B) -- leave blank for local/extractive mode
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Logging level (DEBUG, INFO, WARNING, ERROR)
WNY_NEWS_LOG_LEVEL=INFO
